" vim<->nvim PARITY test for the SpaceVim2 terminal.
"
" Terminals are plain LISTED buffers opened in the current window -- so you can
" open several and switch between them and your files with ordinary buffer
" navigation, identically on Vim (:terminal ++curwin) and Neovim (termopen).
" This locks that behavior on both editors.
"
" The terminals are opened in a throwaway window so the test runner's buffer is
" not replaced.

Execute ( SpaceVim floaterm: opens listed terminal buffers, multiple, with modal keys ):
  " first terminal, in a scratch window
  new
  call SpaceVim#plugins#floaterm#open()
  let st = SpaceVim#plugins#floaterm#status()
  Assert st.is_terminal, 'should be a terminal buffer'
  Assert st.buflisted, 'terminal buffer must be listed (switchable like a file)'
  Assert !empty(maparg('<Esc>', 't')), 'Esc -> navigate mapping is set on the terminal'
  let g:_ft_b1 = st.bufnr

  " a second one is a DISTINCT buffer -> multiple terminals allowed
  new
  call SpaceVim#plugins#floaterm#open()
  let st2 = SpaceVim#plugins#floaterm#status()
  Assert st2.is_terminal
  Assert st2.bufnr != g:_ft_b1, 'each open() creates a new terminal buffer'

  " both remain alive -> you can switch back and forth like files
  Assert bufexists(g:_ft_b1) && bufexists(st2.bufnr), 'both terminals persist'

  " cleanup
  silent! execute 'bwipeout! ' . st2.bufnr
  silent! execute 'bwipeout! ' . g:_ft_b1
  unlet g:_ft_b1
