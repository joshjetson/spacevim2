Execute ( SpaceVim plugin: a.vim ):
  call SpaceVim#plugins#a#set_config_name(getcwd(), '.SpaceVim.d/projections.toml')
  let root = SpaceVim#plugins#a#getConfigPath()
  AssertEqual SpaceVim#plugins#a#get_alt('test/api/job.vader', root, 1), 'autoload/SpaceVim/api/job.vim'
  AssertEqual SpaceVim#plugins#a#get_alt('autoload/SpaceVim/api/job.vim', root, 1), 'test/api/job.vader'
  AssertEqual SpaceVim#plugins#a#get_alt('test/plugin/a.vader', root, 1), 'autoload/SpaceVim/plugins/a.vim'
  AssertEqual SpaceVim#plugins#a#get_alt('autoload/SpaceVim/plugins/a.vim', root, 1), 'test/plugin/a.vader'
  AssertEqual SpaceVim#plugins#a#get_alt('doc/SpaceVim.txt', root, 1), 'doc/SpaceVim.cnx'
  AssertEqual SpaceVim#plugins#a#get_alt('doc/SpaceVim.cnx', root, 1), 'doc/SpaceVim.txt'
  unlet root
